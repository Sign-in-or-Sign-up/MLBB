[Rule]

[MITM]
hostname = akmpicture.youngjoygame.com, akmpicture.ml.mproject.skystone.games

[Rewrite]

# ========== 兜底：五/六位 → unknow.jpg ==========
response if ${url} ~= /^https:\/\/(akmpicture\.youngjoygame\.com|akmpicture\.ml\.mproject\.skystone\.games)\/dist\/face\/\d{5,6}\/\d{1,2}\/\d{1,2}\/(\d{6,10}_)?\d{1,3}(_new_[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?\.jpg/ then response.body.mock_file("jpeg", "https://raw.githubusercontent.com/Sign-in-or-Sign-up/MLBB/main/face/unknow.jpg", 200)

